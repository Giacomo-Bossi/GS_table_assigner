{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "pairings": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "used_tables": {
        "type": "integer",
        "minimum": 0
      },
      "total seats":{
        "type":"integer",
        "minimum": 0
      },
      "total guests":{
        "type": "integer",
        "minimum": 0
      },
      "total assignable":{
        "type":"integer",
        "minimum": 0
      },
      "Warnings":{
        "description": "an array of strings containing warnings regerding the execution of the program",
        "type":"array",
        "items": {"type":"string"}
      }
    },
    "required": ["pairings", "used_tables"]    
}