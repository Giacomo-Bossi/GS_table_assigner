{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "schema for the input to be passed in the web request",
    "description": "description of a table configuration and the guests",
    "type": "object",
    "properties": {
        "tables": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "table_id": {
                        "description": "unique identifier of the table",
                        "type": ["string", "integer"]
                    },
                    "capacity": {
                        "description": "number of seats on the table",
                        "type": "integer",
                        "minimum": 0
                    },
                    "head_seats": {
                        "description": "wether the table has a head seat",
                        "type":["boolean","integer","string"]
                    }
                },
                "required": ["table_id", "capacity"]
            },
            "minItems": 0
        },
        "groups": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "name of the reservations",
                        "anyOf": [
                            { "type": "integer" },
                            { "type": "string", "minLength": 1 }
                        ]
                    },
                    "size": {
                        "description": "amount of people for the reservation",
                        "type": "integer",
                        "minimum": 1
                    },
                    "required_head":{
                        "description": "set to true if the group has special needs and requires a head seat",
                        "type": "boolean"
                        },
                    "close_to":{
                        "description": "array of other group ids to be put together (or a single id)",
                        "anyOf": [
                            {
                                "type": "array",
                                "items": { "type": ["string", "integer"] }
                            },
                            {
                                "type": ["string", "integer"]
                            }
                        ]
                    }
                },
                "required": ["name", "size"]
            },
            "minItems": 0
        }
    },
    "required": ["tables", "groups"]
}